# Copy this file to .env and fill in your real values.
# If environment variables have given you trouble before, it's also
# fine to paste these directly into src/config/db.js and
# src/services/authService.js instead — just don't push real secrets
# to a public repo either way.

DATABASE_URL=postgres://postgres.your-project-ref:your-password@your-pooler-host.pooler.supabase.com:5432/postgres
JWT_SECRET=replace-with-a-long-random-string
PORT=4000
